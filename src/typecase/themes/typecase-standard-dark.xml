<?xml version="1.0" encoding="UTF-8"?>
<!-- Typecase editor theme; a GtkSourceView style scheme. The typecase:* styles color the
     Markdown styling, everything else (including code blocks) comes from the parent scheme. -->
<style-scheme id="typecase-standard-dark" name="Standard" version="1.0" parent-scheme="Adwaita-dark">
  <author>Typecase</author>
  <description>The usual GNOME look</description>
  <metadata>
    <property name="variant">dark</property>
    <property name="light-variant">typecase-standard</property>
  </metadata>
  <style name="typecase:syntax" foreground="#FFFFFF59"/>
  <style name="typecase:link" foreground="#78aeed"/>
  <style name="typecase:code" background="#FFFFFF0F"/>
  <style name="typecase:code-block" foreground="#FFFFFF1F" background="#FFFFFF0A"/>
</style-scheme>
