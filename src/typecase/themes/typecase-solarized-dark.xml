<?xml version="1.0" encoding="UTF-8"?>
<!-- Typecase editor theme; a GtkSourceView style scheme. The typecase:* styles color the
     Markdown styling, everything else (including code blocks) comes from the parent scheme. -->
<style-scheme id="typecase-solarized-dark" name="Solarized" version="1.0" parent-scheme="solarized-dark">
  <author>Typecase</author>
  <description>The classic with muted colors</description>
  <metadata>
    <property name="variant">dark</property>
    <property name="light-variant">typecase-solarized</property>
  </metadata>
  <style name="text" foreground="#93A1A1" background="#002B36"/>
  <style name="typecase:syntax" foreground="#586E75"/>
  <style name="typecase:link" foreground="#268BD2"/>
  <style name="typecase:heading" foreground="#EEE8D5"/>
  <style name="typecase:code" background="#073642"/>
  <style name="typecase:code-block" foreground="#0E4452" background="#04323E"/>
</style-scheme>
