<?xml version="1.0" encoding="UTF-8"?>
<!-- Typecase editor theme; a GtkSourceView style scheme. The typecase:* styles color the
     Markdown styling, everything else (including code blocks) comes from the parent scheme. -->
<style-scheme id="typecase-high-contrast-dark" name="High Contrast" version="1.0" parent-scheme="Adwaita-dark">
  <author>Typecase</author>
  <description>Black on white, or white on black</description>
  <metadata>
    <property name="variant">dark</property>
    <property name="light-variant">typecase-high-contrast</property>
  </metadata>
  <style name="text" foreground="#FFFFFF" background="#000000"/>
  <style name="selection" background="#264F78"/>
  <style name="current-line" background="#141414"/>
  <style name="cursor" foreground="#FFFFFF"/>
  <style name="typecase:syntax" foreground="#A6A6A6"/>
  <style name="typecase:link" foreground="#8AB4F8"/>
  <style name="typecase:heading" foreground="#FFFFFF"/>
  <style name="typecase:code" background="#1F1F1F"/>
  <style name="typecase:code-block" foreground="#8A8A8A" background="#141414"/>
</style-scheme>
