<?xml version="1.0" encoding="UTF-8"?>
<!-- Typecase editor theme; a GtkSourceView style scheme. The typecase:* styles color the
     Markdown styling, everything else (including code blocks) comes from the parent scheme. -->
<style-scheme id="typecase-calm" name="Calm" version="1.0" parent-scheme="Adwaita">
  <author>Typecase</author>
  <description>Cool blue-grey with gentle contrast</description>
  <metadata>
    <property name="variant">light</property>
    <property name="dark-variant">typecase-calm-dark</property>
  </metadata>
  <style name="text" foreground="#3B4252" background="#ECEFF4"/>
  <style name="selection" background="#D8DEE9"/>
  <style name="current-line" background="#E5E9F0"/>
  <style name="cursor" foreground="#4C566A"/>
  <style name="typecase:syntax" foreground="#9AA3B5"/>
  <style name="typecase:link" foreground="#5E81AC"/>
  <style name="typecase:heading" foreground="#2E3440"/>
  <style name="typecase:code" background="#E1E5EC"/>
  <style name="typecase:code-block" foreground="#D2D8E2" background="#E5E9F0"/>
</style-scheme>
