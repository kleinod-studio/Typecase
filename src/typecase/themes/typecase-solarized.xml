<?xml version="1.0" encoding="UTF-8"?>
<!-- Typecase editor theme; a GtkSourceView style scheme. The typecase:* styles color the
     Markdown styling, everything else (including code blocks) comes from the parent scheme. -->
<style-scheme id="typecase-solarized" name="Solarized" version="1.0" parent-scheme="solarized-light">
  <author>Typecase</author>
  <description>The classic with muted colors</description>
  <metadata>
    <property name="variant">light</property>
    <property name="dark-variant">typecase-solarized-dark</property>
  </metadata>
  <style name="text" foreground="#586E75" background="#FDF6E3"/>
  <style name="typecase:syntax" foreground="#93A1A1"/>
  <style name="typecase:link" foreground="#268BD2"/>
  <style name="typecase:heading" foreground="#073642"/>
  <style name="typecase:code" background="#EEE8D5"/>
  <style name="typecase:code-block" foreground="#E4DCC5" background="#F5EFDC"/>
</style-scheme>
