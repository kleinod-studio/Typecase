msgid "Calm Markdown writing"
msgstr "Ruhiges Schreiben in Markdown"

msgid "No Sheet Open"
msgstr "Kein Blatt geöffnet"

msgid "Select a sheet in the library to start writing."
msgstr "Wähle ein Blatt in der Bibliothek, um zu schreiben."

#, python-format
msgid "%(name)s (conflict %(date)s)"
msgstr "%(name)s (Konflikt %(date)s)"

msgid "could not save"
msgstr "Speichern fehlgeschlagen"

msgid "Library"
msgstr "Bibliothek"

msgid "Choose Library Folder…"
msgstr "Bibliotheksordner wählen …"

msgid "New Sheet"
msgstr "Neues Blatt"

msgid "New Group"
msgstr "Neue Gruppe"

msgid "New…"
msgstr "Neu …"

msgid "Rename…"
msgstr "Umbenennen …"

msgid "Move to Trash…"
msgstr "In den Papierkorb …"

msgid "No Library Yet"
msgstr "Noch keine Bibliothek"

msgid ""
"Choose a folder. Its subfolders become groups, its .md files become sheets."
msgstr ""
"Wähle einen Ordner. Seine Unterordner werden zu Gruppen, seine .md-Dateien "
"zu Blättern."

msgid "Show Sidebar"
msgstr "Seitenleiste anzeigen"

msgid "Writing Mode"
msgstr "Schreibmodus"

msgid "Fullscreen"
msgstr "Vollbild"

msgid "Keyboard Shortcuts"
msgstr "Tastenkürzel"

msgid "About Typecase"
msgstr "Über Typecase"

msgid "Main Menu"
msgstr "Hauptmenü"

msgid "Choose Library Folder"
msgstr "Bibliotheksordner wählen"

#, python-format
msgid "“%s” was changed outside Typecase and reloaded."
msgstr "„%s“ wurde außerhalb von Typecase geändert und neu geladen."

#, python-format
msgid "“%s” was deleted outside Typecase."
msgstr "„%s“ wurde außerhalb von Typecase gelöscht."

#, python-format
msgid "“%s” was deleted outside Typecase. Your version was saved again."
msgstr ""
"„%s“ wurde außerhalb von Typecase gelöscht. Deine Fassung wurde neu "
"gespeichert."

msgid "Sheet Changed Elsewhere"
msgstr "Blatt wurde anderswo geändert"

#, python-format
msgid ""
"“%s” was changed outside Typecase while you were writing. Which version "
"should stay in the sheet? The other one is kept as a copy next to it."
msgstr ""
"„%s“ wurde außerhalb von Typecase geändert, während du geschrieben hast. "
"Welche Fassung soll im Blatt bleiben? Die andere wird als Kopie daneben "
"aufbewahrt."

msgid "Load Other Version"
msgstr "Andere Fassung laden"

msgid "Keep My Version"
msgstr "Meine Fassung behalten"

msgid ""
"The other version is not a UTF-8 text file. Your version was saved as a copy."
msgstr ""
"Die andere Fassung ist keine UTF-8-Textdatei. Deine Fassung wurde als Kopie "
"gesichert."

#, python-format
msgid "Could not save: %s"
msgstr "Speichern fehlgeschlagen: %s"

#, python-format
msgid "The other version was kept as “%s”."
msgstr "Die andere Fassung liegt jetzt in „%s“."

msgid "not a UTF-8 text file"
msgstr "keine UTF-8-Textdatei"

#, python-format
msgid "Could not open “%(name)s”: %(reason)s"
msgstr "„%(name)s“ konnte nicht geöffnet werden: %(reason)s"

#, python-format
msgid "%(count)s word"
msgid_plural "%(count)s words"
msgstr[0] "%(count)s Wort"
msgstr[1] "%(count)s Wörter"

#, python-format
msgid "%(count)s character"
msgid_plural "%(count)s characters"
msgstr[0] "%(count)s Zeichen"
msgstr[1] "%(count)s Zeichen"

msgid "Could Not Save"
msgstr "Speichern fehlgeschlagen"

msgid ""
"The latest changes to this sheet could not be saved. Closing now would lose "
"them."
msgstr ""
"Die letzten Änderungen an diesem Blatt konnten nicht gesichert werden. Beim "
"Schließen gingen sie verloren."

msgid "Keep Editing"
msgstr "Weiterschreiben"

msgid "Close Without Saving"
msgstr "Ohne Sichern schließen"

msgid "Rename"
msgstr "Umbenennen"

msgid "Editor"
msgstr "Editor"

msgid "Undo"
msgstr "Rückgängig"

msgid "Redo"
msgstr "Wiederholen"

msgid "New Line Without List Marker"
msgstr "Neue Zeile ohne Listenzeichen"

msgid "Window"
msgstr "Fenster"

msgid "Leave Writing Mode"
msgstr "Schreibmodus verlassen"

msgid "Quit"
msgstr "Beenden"

msgid "Untitled"
msgstr "Unbenannt"

#, python-format
msgid "Could not create the sheet: %s"
msgstr "Das Blatt konnte nicht angelegt werden: %s"

#, python-format
msgid "Could not create the group: %s"
msgstr "Die Gruppe konnte nicht angelegt werden: %s"

msgid "Rename Group"
msgstr "Gruppe umbenennen"

msgid "Rename Sheet"
msgstr "Blatt umbenennen"

msgid "Cancel"
msgstr "Abbrechen"

msgid "This name is not allowed."
msgstr "Dieser Name ist nicht erlaubt."

#, python-format
msgid "“%s” already exists."
msgstr "„%s“ gibt es schon."

#, python-format
msgid "Could not rename: %s"
msgstr "Umbenennen fehlgeschlagen: %s"

#, python-format
msgid "Move “%s” to the Trash?"
msgstr "„%s“ in den Papierkorb legen?"

msgid "The group and everything in it will be moved to the trash."
msgstr "Die Gruppe und alles darin wird in den Papierkorb gelegt."

msgid "The sheet will be moved to the trash."
msgstr "Das Blatt wird in den Papierkorb gelegt."

msgid "Move to Trash"
msgstr "In den Papierkorb"

#, python-format
msgid "Could not move to the trash: %s"
msgstr "Verschieben in den Papierkorb fehlgeschlagen: %s"
