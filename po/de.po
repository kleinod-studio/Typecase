#, python-format
msgid "“%s” was changed outside Typecase and reloaded."
msgstr "„%s“ wurde außerhalb von Typecase geändert und neu geladen."

#, python-format
msgid "“%s” was deleted outside Typecase."
msgstr "„%s“ wurde außerhalb von Typecase gelöscht."

#, python-format
